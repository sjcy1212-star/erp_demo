# ── 비밀값 (API 키 등) — 절대 올리지 않음 ──
.env
.env.*
!.env.example

# ── 운영체제가 만드는 파일 ──
Thumbs.db
desktop.ini
.DS_Store

# ── 편집기 설정 ──
.vscode/
.idea/
*.swp

# ── Node.js ──
node_modules/
npm-debug.log*
package-lock.json

# ── Python ──
__pycache__/
*.pyc
.venv/
venv/

# ── 테스트·브라우저 자동화 산출물 ──
test-results/
playwright-report/
*.log

# ── DART 회사 고유번호 캐시 (서버가 자동 생성, 약 10MB) ──
미사용/dart_app/cache/
